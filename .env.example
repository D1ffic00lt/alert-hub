# Copy to .env for local Compose use. Production should use a root-owned file
# outside the checkout, for example /opt/alert-hub/config/alert-hub.env.

# Visible provider/PWA title: normalized text, non-empty, at most 80 characters.
APP_NAME=Alert Hub
GRAFANA_URL=https://grafana.example.invalid/
ENVIRONMENT=development
# Application and Uvicorn error logs. Production should keep JSON; text is a
# local-development option. Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
LOG_FORMAT=json

# Stable, non-secret identity. Never reuse a node ID for a rebuilt node.
NODE_ID=dev-node
NODE_NAME=dev-node
NODE_REGION=local
PUBLIC_API_URL=http://127.0.0.1:8080
PRIVATE_PEER_URL=http://alert-hub:8080

INGEST_ENABLED=true
NOTIFY_ENABLED=true
SYNC_ENABLED=true
UI_ENABLED=true

DATABASE_URL=sqlite:////data/alert-hub.db
SQLITE_BUSY_TIMEOUT_MS=5000
MIGRATE_ON_START=true
AUTO_CREATE_SCHEMA=false
BOOTSTRAP_TOKEN_FILE=/data/bootstrap-token

# Development defaults match `http://127.0.0.1:8080`. Production must use its
# exact public HTTPS origin and enable secure cookies; never use `*`.
TRUSTED_ORIGINS=http://127.0.0.1:8080
# Trust only proxies that actually append/replace forwarding headers. The split
# Compose model adds only its dedicated web-container address; add an exact
# outer-proxy CIDR only after inventorying the real chain. Peer sender CIDRs
# belong below, not here.
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Bounded, process-local limits. These are per node, not cluster-global lockouts.
RATE_LIMIT_MAX_KEYS=10000
RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=60
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
BOOTSTRAP_RATE_LIMIT_ATTEMPTS=5
BOOTSTRAP_RATE_LIMIT_WINDOW_SECONDS=300
INGEST_RATE_LIMIT_ATTEMPTS=120
INGEST_RATE_LIMIT_WINDOW_SECONDS=60
PEER_RATE_LIMIT_ATTEMPTS=600
PEER_RATE_LIMIT_WINDOW_SECONDS=60

# Production must set these file-backed values to files mounted under
# /run/secrets. They are intentionally unset in this universal development
# example so `cp .env.example .env && docker compose up -d` works without
# committing or inventing installation secrets.
# MASTER_ENCRYPTION_KEY_FILE=/run/secrets/master-encryption-key
# SIGNING_KEY_FILE=/run/secrets/token-signing-key
# CLUSTER_SECRET_FILE=/run/secrets/cluster-bearer-secret
# VAPID_PRIVATE_KEY_FILE=/run/secrets/vapid-private-key
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Comma-separated private peer URLs. Peer routes must remain on WireGuard or an
# equivalent private network and must not be exposed by the host firewall.
PEER_URLS=
# Replace this loopback-only fail-closed default with the exact WireGuard/private
# sender CIDRs on a node that accepts remote peers.
PEER_ALLOWED_CIDRS=127.0.0.0/8,::1/128
SYNC_INTERVAL_SECONDS=5
SYNC_PAGE_SIZE=250
SYNC_CONNECT_TIMEOUT_SECONDS=2
SYNC_READ_TIMEOUT_SECONDS=10
SYNC_WRITE_TIMEOUT_SECONDS=10
SYNC_POOL_TIMEOUT_SECONDS=2
SYNC_BACKOFF_INITIAL_SECONDS=1
SYNC_BACKOFF_MAX_SECONDS=60
SYNC_BACKOFF_JITTER_RATIO=0.2
SYNC_MAX_PAGES_PER_CYCLE=100
SYNC_MAX_RESPONSE_BYTES=4194304
CLOCK_SKEW_THRESHOLD_SECONDS=300

# Monitoring datasource egress is HTTPS/public-only by default. Enable these
# only when Prometheus is intentionally reachable on a private monitoring network.
ALLOW_HTTP_MONITORING_URLS=false
ALLOW_PRIVATE_MONITORING_URLS=false
PROMETHEUS_CONNECT_TIMEOUT_SECONDS=2
PROMETHEUS_READ_TIMEOUT_SECONDS=10
PROMETHEUS_WRITE_TIMEOUT_SECONDS=5
PROMETHEUS_POOL_TIMEOUT_SECONDS=2
PROMETHEUS_QUERY_TIMEOUT_SECONDS=8
PROMETHEUS_MAX_RESPONSE_BYTES=2097152
PROMETHEUS_MAX_SAMPLES=10000
MAX_PAYLOAD_BYTES=1048576

# Docker Compose controls. Each release publishes independent API and web images
# with the same version and separate digests. Production pins immutable digest
# references; local builds use these names.
ALERT_HUB_API_IMAGE=alert-hub-api:dev
ALERT_HUB_WEB_IMAGE=alert-hub-web:dev
ALERT_HUB_BIND_ADDRESS=127.0.0.1
ALERT_HUB_HOST_PORT=8080
ALERT_HUB_DATA_VOLUME=alert-hub-data
# The default Compose files use a named data volume so a plain clone starts on
# Linux without a root-owned bind-directory problem. Secrets remain a local,
# ignored bind directory and are optional in development.
ALERT_HUB_SECRETS_DIR=./runtime/secrets
ALERT_HUB_ENV_FILE=.env
ALERT_HUB_RESTART_POLICY=unless-stopped
# A small dedicated bridge makes the web proxy address explicit, so the API can
# trust only that proxy. Change all three values together if this subnet clashes
# with a local Docker network.
ALERT_HUB_EDGE_SUBNET=10.254.240.0/29
ALERT_HUB_API_IP=10.254.240.2
ALERT_HUB_WEB_IP=10.254.240.3
MONITORING_NETWORK=monitoring
