# Install as /etc/alert-hub/backup.env, owned by root and mode 0600.
NODE_NAME=ru
DATABASE_PATH=/opt/alert-hub/data/alert-hub.db
BACKUP_DIR=/opt/alert-hub/backups
# Must match `container_name` in Compose. Restore also scans every running
# container for a writable bind mount that contains DATABASE_PATH.
CONTAINER_NAME=alert-hub-api
DATABASE_UID=10001
DATABASE_GID=10001
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
