# Dedicated HTTPS peer virtual host. Keep this hostname distinct from the
# public UI hostname: the public Caddyfile must continue to deny /internal/*.
#
# Caddy obtains and renews this hostname's certificate. Publish the peer DNS
# record directly to this proxy (DNS-only, without a CDN or another L7 proxy),
# because the source allowlist deliberately matches the TCP peer address.
__SERVER_NAME__ {
	request_body {
		max_size 1MB
	}

	route {
		# Repeated --peer-cidr installer arguments render as exact /32s here.
		# A failed/masked source-address inventory therefore fails closed.
		@source_denied not remote_ip __PEER_CIDRS__
		respond @source_denied 403

		@peer_health {
			method GET
			path /internal/v1/nodes/health
		}
		reverse_proxy @peer_health __UPSTREAM__ {
			# Never let an Internet client author the address checked by the
			# API's PEER_ALLOWED_CIDRS policy.
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Real-IP {http.request.remote.host}
			header_up X-Forwarded-Proto https
			header_up -Forwarded
			header_up -X-Forwarded-Host
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}

		@peer_query {
			method POST
			path /internal/v1/sync/events/query
		}
		reverse_proxy @peer_query __UPSTREAM__ {
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Real-IP {http.request.remote.host}
			header_up X-Forwarded-Proto https
			header_up -Forwarded
			header_up -X-Forwarded-Host
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}

		# This hostname is not a second public API. Wrong methods, every other
		# internal operation, UI/API paths, metrics, and diagnostics stay dark.
		respond 404
	}
}
