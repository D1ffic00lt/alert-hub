# Optional private-only peer listener. Replace __WIREGUARD_IP__ with one exact
# local WireGuard address and restrict source CIDRs again at the host firewall.
server {
    listen __WIREGUARD_IP__:8443 ssl;
    server_name _;

    ssl_certificate /etc/ssl/alert-hub-peer/fullchain.pem;
    ssl_certificate_key /etc/ssl/alert-hub-peer/privkey.pem;

    allow __PEER_CIDR__;
    deny all;
    client_max_body_size 2m;

    location /internal/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location / {
        return 404;
    }
}
