# Standalone example. If an existing Caddyfile imports snippets, move only the
# site block into the imported directory and retain the installation's global
# options. Replace placeholders with install-proxy-config.sh, then validate.
{
    servers {
        trusted_proxies static __TRUSTED_PROXY_CIDR__
        client_ip_headers X-Forwarded-For
    }
}

__SERVER_NAME__ {
    encode zstd gzip

    request_body {
        max_size 1MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; connect-src 'self' https: wss:; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        -Server
    }

    @internal path /internal/*
    respond @internal 404

    # Keep telemetry, peer diagnostics, and API documentation private. Scrape
    # the loopback/private application listener from the monitoring network.
    @operator_only path /metrics /health/deep /api/docs /api/docs/* /api/redoc /api/redoc/* /api/openapi.json
    respond @operator_only 404

    @events path /api/v1/stream
    handle @events {
        header {
            Cache-Control "no-cache, no-store"
            X-Accel-Buffering "no"
        }
        reverse_proxy __UPSTREAM__ {
            flush_interval -1
            transport http {
                dial_timeout 5s
                response_header_timeout 1h
            }
        }
    }

    @service_worker path /sw.js
    header @service_worker {
        Cache-Control "no-cache, no-store, must-revalidate"
        Service-Worker-Allowed "/"
    }

    @runtime_files path /manifest.webmanifest /runtime-config.js
    header @runtime_files Cache-Control "no-store"

    @immutable path_regexp immutable ^/assets/.+-[0-9A-Za-z_-]{8,}\.(?:css|js|woff2?|png|svg)$
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    reverse_proxy __UPSTREAM__ {
        header_up X-Forwarded-Proto https
        transport http {
            dial_timeout 5s
            response_header_timeout 60s
        }
    }
}
